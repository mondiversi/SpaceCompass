<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tutorial_title" formatted="false">教程</string>
    <string name="tutorial_welcome_title" formatted="false">欢迎使用 Space Compass</string>
    <string name="tutorial_welcome_body" formatted="false">探索不同地点和时刻的天空与天体轨迹。通过交互式教程了解主要操作。</string>
    <string name="tutorial_instruction" formatted="false">轻触高亮的控件或轨道点即可了解其功能，不会更改设置。</string>
    <string name="tutorial_zoom_title" formatted="false">缩放</string>
    <string name="tutorial_navigation_title" formatted="false">选中天体</string>
    <string name="tutorial_points_title" formatted="false">轨道点</string>
    <string name="tutorial_info" formatted="false">打开应用信息、更新内容和来源说明。</string>
    <string name="tutorial_menu" formatted="false">打开设置、已保存场景和教程。</string>
    <string name="tutorial_objects" formatted="false">选择显示的天体。可以搜索、筛选和保存收藏。</string>
    <string name="tutorial_location" formatted="false">自定义位置、海拔、时区、日期、时间和时间流速。</string>
    <string name="tutorial_guides" formatted="false">选择网格、数值和行星参考线，然后点按应用。</string>
    <string name="tutorial_forward" formatted="false">0–24显示整个日历日；+24h显示从当前显示时刻开始的24小时。</string>
    <string name="tutorial_camera" formatted="false">选择模式和视图，然后点按应用。关闭会保留当前设置。</string>
    <string name="tutorial_weather" formatted="false">显示或隐藏模拟天空和全景中的天气效果。</string>
    <string name="tutorial_axis" formatted="false">选择相机轴（90°）或手机长轴（0°）。</string>
    <string name="tutorial_transparency" formatted="false">让天体图像更透明，以便与相机画面比较。</string>
    <string name="tutorial_zoom" formatted="false">通过按钮或双指放大或缩小。</string>
    <string name="tutorial_capture" formatted="false">生成图像后，可在预览中选择网格、标签和位置；天空和地球仪模式还可切换取景画面与全景。</string>
    <string name="tutorial_panels" formatted="false">收起或展开天体与指南针面板，为天空留出更多空间。</string>
    <string name="tutorial_antipodes" formatted="false">点按显示或隐藏对跖点。长按可取消选择所有点。</string>
    <string name="tutorial_navigation" formatted="false">浏览已选天体。面板显示当前天体及其轨迹颜色。</string>
    <string name="tutorial_observatory" formatted="false">打开天体数据、轨迹、关键高度、事件和个人时刻。</string>
    <string name="tutorial_daily" formatted="false">查看轨迹、时刻、高度及可选轨道点。未来事件可以设置提醒。</string>
    <string name="tutorial_gps" formatted="false">查看真实位置、GPS海拔、朝向和天气，与Location设置无关。</string>
    <string name="tutorial_points" formatted="false">选择或取消选择一个点。对准后可查看时间、T、方位角和高度。</string>
    <string name="tutorial_reticle_title" formatted="false">时间与界面</string>
    <string name="tutorial_reticle" formatted="false">轻触空白处可暂停或继续时间。双击可显示或隐藏界面和面板；网格保持可见。</string>
    <string name="tutorial_reminder" formatted="false">为适用的未来事件打开Android闹钟或日历。过去事件和当前位置不能设置闹钟。</string>
    <string name="tutorial_status_title" formatted="false">状态与恢复</string>
    <string name="tutorial_status" formatted="false">查看位置、天气和轨道数据的状态及可用操作。</string>
    <string name="tutorial_remove" formatted="false">确认后，将当前天体从已选天体中移除。</string>
</resources>
